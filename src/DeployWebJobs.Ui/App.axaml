<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeployWebJobs.Ui.App"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <FluentTheme />

    <!-- Tarjeta: el bloque con borde redondeado que agrupa cada sección -->
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#12808080" />
      <Setter Property="BorderBrush" Value="#30808080" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>

</Application>
