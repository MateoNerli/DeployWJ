<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeployWebJobs.Ui.Views.HelpView">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="0,0,14,0">
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="¿Cómo funciona?" />
        <TextBlock Classes="muted" Text="Del proyecto compilado al WebJob corriendo en cada cliente." />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Sections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Margin="0,0,0,12">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
