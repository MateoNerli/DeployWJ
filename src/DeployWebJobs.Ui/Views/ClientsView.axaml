<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeployWebJobs.Ui.Views.ClientsView">

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,14,16">
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="Clientes" />
        <TextBlock Classes="muted" Text="{Binding CountText}" />
      </StackPanel>
      <WrapPanel>
        <Button Classes="accent" Content="Agregar cliente" Command="{Binding AddCommand}" Margin="0,0,8,8" />
        <Button Content="Exportar para compañeros…" Command="{Binding ExportPackageCommand}" Margin="0,0,8,8" />
        <Button Content="Importar paquete…" Command="{Binding ImportPackageCommand}" Margin="0,0,8,8" />
        <Button Content="Importar desde Excel…" Command="{Binding ImportCommand}" Margin="0,0,8,8" />
      </WrapPanel>
    </StackPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,14,0" Spacing="8">
        <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasNoClients}"
                   Text="Todavía no hay clientes. Agregá uno con el botón de arriba o importá el Excel anterior (ConexionesFTP.xlsx)." />
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Padding="14,10" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding Host}" Classes="muted" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" />
                      <TextBlock Text="{Binding CredentialsText}" Foreground="{Binding CredentialsBrush}" FontSize="12" />
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Editar" Command="{Binding EditCommand}" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="Quitar" Command="{Binding DeleteCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
